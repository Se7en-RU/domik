{
  "name": "domik",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/roomplan.test.mjs && node scripts/validate-model.mjs",
    "measurements:audit": "node scripts/roomplan-audit.mjs",
    "measurements:apply": "node scripts/roomplan-audit.mjs --apply",
    "measurements:apply-heights": "node scripts/roomplan/apply-heights.mjs",
    "export:model": "node scripts/export.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "esbuild": "0.27.3",
    "oxfmt": "0.61.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
